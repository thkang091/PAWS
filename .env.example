EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ENABLE_PAID_PLANS=false
EXPO_PUBLIC_ENABLE_REAL_DOG_AI=false
EXPO_PUBLIC_ENABLE_SENSOR_ROUTINES=true
EXPO_PUBLIC_ENABLE_RANKED_GAMES=false
EXPO_PUBLIC_DOG_AI_BASE_URL=

# Google Maps SDK key (iOS + Android), used by the walk screen's real map.
# Needs Maps SDK for iOS and Maps SDK for Android enabled on the key.
GOOGLE_MAPS_API_KEY=

# Gemini is called through the `gemini` Supabase edge function. Set GEMINI_API_KEY as a function secret, not here.
